# SenScript Environment Configuration

## User API Keys (Optional)
# Users can set these in the UI settings modal
# If not provided, fallback keys will be used

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

## Fallback Keys (SenScript Pro Keys)
# These are used when users don't provide their own keys
# In production, these would be valid paid API keys

FALLBACK_OPENAI_KEY=sk-proj-fallback-key-for-senscript-users
FALLBACK_ANTHROPIC_KEY=sk-ant-fallback-key-for-senscript-users
FALLBACK_DEEPSEEK_KEY=sk-fallback-key-for-senscript-users

## Model Selection (Advanced Users)
# Override default models - these should be the FASTEST models
# for the best user experience

OPENAI_MODEL=gpt-3.5-turbo             # Fastest OpenAI model
ANTHROPIC_MODEL=claude-3-haiku-20240307 # Fastest Anthropic model  
DEEPSEEK_MODEL=deepseek-chat           # Fastest DeepSeek model

## API Response Limits (Cost Control)
OPENAI_MAX_TOKENS=150                  # Reduced for efficiency
OPENAI_TEMPERATURE=0.5                 # Lower for consistency

ANTHROPIC_MAX_TOKENS=150
ANTHROPIC_TEMPERATURE=0.5

DEEPSEEK_MAX_TOKENS=150
DEEPSEEK_TEMPERATURE=0.5

## Server Configuration
PORT=3002
NODE_ENV=development

## React Native Compatibility Settings
# These ensure the backend can support mobile app integration

CORS_ORIGIN=*                          # Allow all origins for development
MOBILE_API_VERSION=v1                  # API versioning for mobile
WEBSOCKET_ENABLED=false                # Real-time updates (future feature)